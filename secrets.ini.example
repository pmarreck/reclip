# ReClip+ secrets — copy this file to ~/.config/reclip+/secrets.ini
# (or wherever RECLIP_CONFIG_DIR points) and chmod 600 it.
#
# Same syntax as config.ini: KEY=value, quotes optional, ${VAR} interpolation
# supported. The file is hot-reloaded on mtime change.
#
# Precedence: config.ini literal > real os.environ > secrets.ini > default.
# In practice that means: anything you put here acts as a fallback for keys
# not set in your shell env and not literally overridden in config.ini.
#
# Why this file exists at all: when ReClip+ runs as a launchd/systemd-user
# service, it doesn't inherit your interactive shell env (PATH, RECLIP_*, etc.
# from .bashrc/.zshrc/.profile are NOT visible to the service process). Baking
# secrets into the service file at install time goes stale on rotation, so
# this file is the cross-platform escape hatch: edit, save, done — no restart,
# no reinstall.
#
# DO NOT commit this file. ~/.config/reclip+/secrets.ini lives outside the
# repo by default; secrets.ini in the project dir is also gitignored just in
# case.

# --- API keys ---
# RECLIP_API_KEY is the global fallback. All per-service keys default to it
# via ${RECLIP_API_KEY:-...} chains in config.ini.
RECLIP_API_KEY=

# Per-service overrides (uncomment + fill in if your providers differ):
# RECLIP_STT_API_KEY=
# RECLIP_SUMMARIZE_API_KEY=
# RECLIP_TRANSLATE_API_KEY=
# RECLIP_COUNTERARGUE_API_KEY=
# RECLIP_TTS_API_KEY=
